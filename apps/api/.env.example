NODE_ENV=development
PORT=5000

# MongoDB Atlas or a directly installed MongoDB instance. Do not commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/edvixa?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=20

# Comma-separated frontend origins allowed to use credentialed browser requests.
CLIENT_URL=http://localhost:5173
# Public frontend URL used in verification emails.
APP_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=1
API_RATE_LIMIT=300

# AI-generated practice questions. Choose one provider and configure its key.
# Model names are configurable so they can be upgraded without a code release.
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Use console only for local development. Production validation requires Resend and a verified sender domain.
EMAIL_PROVIDER=console
EMAIL_FROM=Edvixa <onboarding@resend.dev>
RESEND_API_KEY=

ADMIN_NAME=Edvixa Admin
ADMIN_EMAIL=admin@edvixa.local
ADMIN_PASSWORD=ChangeMe123!

# Use demo only for development. Production should use razorpay with all three secrets.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
