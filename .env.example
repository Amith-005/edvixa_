# API
NODE_ENV=development
PORT=5000
# Use your MongoDB Atlas connection string. Replace username, password, and cluster host.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/edvixa?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
ADMIN_NAME=Edvixa Admin
ADMIN_EMAIL=admin@edvixa.local
ADMIN_PASSWORD=ChangeMe123!

# Web
VITE_API_URL=http://localhost:5000/api/v1

# Payments
# Keep demo while developing without credentials. Change to razorpay after adding keys.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
